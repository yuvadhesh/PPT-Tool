# ─────────────────────────────────────────────────────────────
# AccessPPT Environment Configuration
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME=AccessPPT
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string

# Database (PostgreSQL)
POSTGRES_USER=accessppt
POSTGRES_PASSWORD=accessppt
POSTGRES_DB=accessppt
DATABASE_URL=postgresql+asyncpg://accessppt:accessppt@postgres:5432/accessppt
DATABASE_SYNC_URL=postgresql://accessppt:accessppt@postgres:5432/accessppt

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Gemini AI (Optional - system uses rule engine & semantic heuristics when key is not provided)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# S3 / MinIO Object Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=accessppt
S3_REGION=us-east-1
S3_USE_SSL=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost/api/v1
