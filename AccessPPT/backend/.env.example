# Application
APP_NAME=AccessPPT
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars

# Database
DATABASE_URL=postgresql+asyncpg://accessppt:accessppt@localhost:5432/accessppt
DATABASE_SYNC_URL=postgresql://accessppt:accessppt@localhost:5432/accessppt

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# S3 / MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=accessppt
S3_REGION=us-east-1
S3_USE_SSL=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# File Upload Limits
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=pptx

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
