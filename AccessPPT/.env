# AccessPPT Environment Configuration
APP_NAME=AccessPPT
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=super-secret-jwt-key-accessppt-production-min-32-chars
JWT_SECRET=super-secret-jwt-key-accessppt-production-min-32-chars

# Database (SQLite for immediate zero-config standalone execution, or PostgreSQL in Docker)
DATABASE_URL=sqlite+aiosqlite:///./accessppt.db
DATABASE_SYNC_URL=sqlite:///./accessppt.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Gemini AI
GEMINI_API_KEY=AQ.Ab8RN6JhOfRZZyiu4RbM6umrELtMx18A6aYrO5Ccesnr1T57hw
GEMINI_MODEL=gemini-3.5-flash

# S3 / MinIO (with automatic local filesystem fallback)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=accessppt
S3_REGION=us-east-1
S3_USE_SSL=false

MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=pptx
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
